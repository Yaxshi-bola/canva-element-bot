{
  "version": 2,
  "name": "canva-element-kodlari-zuhra-olimova",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://canva-elements.pages.dev/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
